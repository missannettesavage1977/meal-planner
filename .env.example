# Copy to .env.local for local development. Never commit real secrets.
# The app runs fully without any of these: data is stored in the browser and
# prices are clearly-labelled demonstration estimates.

# --- Optional: AI interpretation of "Anything special this week?" -----------
# Server-side only (never prefixed with NEXT_PUBLIC_). Without it the app uses
# its built-in rule-based parser.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
ANTHROPIC_MODEL=

# --- Future: Supabase cloud sync ---------------------------------------------
# The schema, RLS policies and seed data are in supabase/. The app does not
# yet read these variables – cloud sync is not wired into the UI.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server/CI only – never expose to the browser
